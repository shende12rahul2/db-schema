# Copy to .env and fill in. .env is git-ignored: never commit it, never put real credentials in this file.
# Another target: copy to .env.<name> (e.g. .env.test) and run  migrate.sh --env <name> <command>.

# ---- which target is this? ----
APP_ENV=dev                 # dev | test | prod  (free text; names listed in PROTECTED_ENVS get extra protection)
PROTECTED_ENVS=prod         # comma-separated. For these, migrate/undo/repair/baseline need CONFIRM=<EXPECTED_DB>
EXPECTED_DB=                # service/PDB name you EXPECT to be connected to; a mismatch aborts before anything runs.
                            # REQUIRED for protected environments, strongly recommended everywhere.

# ---- how to reach the database (shared server: each developer uses their OWN schema user) ----
RUNNER=local                # local         = sqlplus installed on this machine
                            # docker-client = small helper container provides sqlplus; the DB is NOT in Docker
                            # docker        = throw-away Oracle in Docker for people without a server (optional)
DB_HOST=
DB_PORT=1521
DB_SERVICE=                 # service name / PDB
DB_USER=                    # schema owner = the account the objects are created in (one per developer / client)
DB_PASSWORD=                # quotes allowed: "pa ss#word"
# CONN=                     # optional full SQL*Plus connect string; overrides the five values above (wallet / TNS alias)

# ---- only for RUNNER=docker ----
# HOST_PORT=1521
# ORACLE_PASSWORD=
# APP_USER=
# APP_USER_PASSWORD=
